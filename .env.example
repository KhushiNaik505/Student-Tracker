# Copy this file to ".env" (copy .env.example .env) and fill in YOUR values. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studenttrack
DB_USER=postgres
DB_PASSWORD=change-me

# Google Sheets (see README step 6). Path to the service-account JSON you download from Google Cloud.
GOOGLE_SHEETS_CREDENTIALS_FILE=C:\secrets\studenttrack-service-account.json
# The long ID in the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Two-way sync: validated edits typed into Google Sheets are saved to the database (1 = on, 0 = off)
# TWO_WAY_SYNC=1
# How often (seconds) the worker checks the sheet for edits
# SHEET_POLL_SECONDS=30

# Optional: seconds the worker waits to batch rapid changes (default 2)
# SYNC_DEBOUNCE_SECONDS=2

# Only for running the automated tests: a SEPARATE database whose name contains "test"
# (tests TRUNCATE tables, so never point this at your real database)
# TEST_DB_NAME=studenttrack_test

# Hosted database (Neon / Supabase): use sslmode require and skip CREATE DATABASE
# DB_SSLMODE=require
# DB_SKIP_CREATE=1
# Hosting without a key file: paste the whole service-account JSON here instead (see DEPLOY.md)
# GOOGLE_SERVICE_ACCOUNT_JSON=
